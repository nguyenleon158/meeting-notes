{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "keyPoints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actionItems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "assignee": {
            "type": "string"
          },
          "dueDate": {
            "type": "string"
          }
        },
        "required": [
          "text",
          "assignee",
          "dueDate"
        ],
        "additionalProperties": false
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "summary",
    "keyPoints",
    "decisions",
    "actionItems",
    "openQuestions"
  ],
  "additionalProperties": false
}
